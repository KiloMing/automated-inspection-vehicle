<?xml version="1.0"?>
<!-- Gazebo namespace -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema"
       name="mecanum_robot">

    <!-- Robot dimensions -->
    <xacro:property name="base_length" value="0.30"/>
    <xacro:property name="base_width" value="0.18"/>
    <xacro:property name="base_height" value="0.08"/>
    <xacro:property name="base_mass" value="4.0"/>

    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width" value="0.04"/>
    <xacro:property name="wheel_mass" value="0.30"/>

    <!-- Wheel center offsets -->
    <xacro:property name="wheel_x" value="0.11"/>
    <xacro:property name="wheel_y" value="0.15"/>

    <!-- Base link -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.35 0.8 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="${base_mass}"/>
            <inertia
                ixx="${base_mass * (base_width**2 + base_height**2) / 12.0}"
                ixy="0" ixz="0"
                iyy="${base_mass * (base_length**2 + base_height**2) / 12.0}"
                iyz="0"
                izz="${base_mass * (base_length**2 + base_width**2) / 12.0}"/>
        </inertial>
    </link>


    <!-- Simplified Mecanum wheel -->
    <xacro:macro name="wheel" params="name x y fdir">

        <link name="${name}_wheel_link">

            <!-- Visual: keep cylindrical appearance -->
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>

            <!-- Collision: spherical contact model -->
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>

            <!-- Approximate spherical inertia -->
            <inertial>
                <mass value="${wheel_mass}"/>
                <inertia
                    ixx="${0.4 * wheel_mass * wheel_radius**2}"
                    ixy="0" ixz="0"
                    iyy="${0.4 * wheel_mass * wheel_radius**2}"
                    iyz="0"
                    izz="${0.4 * wheel_mass * wheel_radius**2}"/>
            </inertial>

        </link>

        <joint name="${name}_wheel_joint" type="continuous">

            <parent link="base_link"/>
            <child link="${name}_wheel_link"/>

            <origin xyz="${x} ${y} ${-wheel_radius}"
                    rpy="0 0 0"/>

            <axis xyz="0 1 0"/>

            <limit effort="15.0" velocity="30.0"/>

            <dynamics damping="0.05" friction="0.0"/>

        </joint>

        <!-- Direction-dependent Mecanum friction -->
        <gazebo reference="${name}_wheel_link">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>0.0</mu2>
                            <fdir1 gz:expressed_in="base_link">${fdir}</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>

    </xacro:macro>

    <!-- Four independently rotating wheels -->

    <!-- Front left -->
    <xacro:wheel
        name="front_left"
        x="${wheel_x}"
        y="${wheel_y}"
        fdir="1 -1 0"/>

    <!-- Front right -->
    <xacro:wheel
        name="front_right"
        x="${wheel_x}"
        y="${-wheel_y}"
        fdir="1 1 0"/>

    <!-- Rear left -->
    <xacro:wheel
        name="rear_left"
        x="${-wheel_x}"
        y="${wheel_y}"
        fdir="1 1 0"/>

    <!-- Rear right -->
    <xacro:wheel
        name="rear_right"
        x="${-wheel_x}"
        y="${-wheel_y}"
        fdir="1 -1 0"/>

    <!-- Include Gazebo control -->
    <xacro:include filename="ros2_control.xacro"/>

</robot>
