<?xml version="1.0"?>
<robot name="inspection_mecanum" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <xacro:arg name="geometry_file" default="$(find mecanum_bringup)/config/geometry.yaml"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="simulation" default="false"/>
  <xacro:property name="g" value="${xacro.load_yaml('$(arg geometry_file)')}"/>
  <xacro:property name="r" value="${g['radius']}"/>
  <link name="base_link">
    <inertial><origin xyz="0 0 ${r+0.04}"/><mass value="4"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
    <visual><origin xyz="0 0 ${r+0.04}"/><geometry><box size="${g['body_length']} ${g['body_width']} ${g['body_height']}"/></geometry><material name="blue"><color rgba="0.1 0.3 0.8 1"/></material></visual>
    <collision><origin xyz="0 0 ${r+0.04}"/><geometry><box size="${g['body_length']} ${g['body_width']} ${g['body_height']}"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="name x y friction_y">
    <link name="${name}_wheel">
      <inertial><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.0002"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${r}" length="0.025"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <!-- Anisotropic sphere contact approximates rollers; not a full roller model. -->
      <collision><geometry><sphere radius="${r}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${y} ${r}"/><axis xyz="0 1 0"/>
      <limit effort="5" velocity="20"/><dynamics damping="0.01" friction="0"/>
    </joint>
    <xacro:if value="$(arg simulation)">
      <gazebo reference="${name}_wheel">
        <!-- Nested extension preserves gz:expressed_in through SDFormat conversion. -->
        <collision><surface><friction><ode>
          <mu>1.0</mu><mu2>0.0</mu2>
          <fdir1 gz:expressed_in="base_link">1 ${friction_y} 0</fdir1>
        </ode></friction></surface></collision>
      </gazebo>
    </xacro:if>
  </xacro:macro>
  <xacro:wheel name="front_left" x="${g['half_length']}" y="${g['half_width']}" friction_y="-1"/>
  <xacro:wheel name="front_right" x="${g['half_length']}" y="${-g['half_width']}" friction_y="1"/>
  <xacro:wheel name="rear_left" x="${-g['half_length']}" y="${g['half_width']}" friction_y="1"/>
  <xacro:wheel name="rear_right" x="${-g['half_length']}" y="${-g['half_width']}" friction_y="-1"/>
  <link name="laser_link">
    <inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.035" length="0.03"/></geometry></visual>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/>
    <origin xyz="${g['laser_x']} ${g['laser_y']} ${g['laser_z']}" rpy="0 0 ${g['laser_yaw']}"/>
  </joint>
  <xacro:if value="$(arg simulation)">
    <ros2_control name="MecanumGazeboSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:macro name="interface" params="name">
        <joint name="${name}_wheel_joint"><command_interface name="velocity"/>
          <state_interface name="position"/><state_interface name="velocity"/></joint>
      </xacro:macro>
      <xacro:interface name="front_left"/><xacro:interface name="front_right"/>
      <xacro:interface name="rear_left"/><xacro:interface name="rear_right"/>
    </ros2_control>
    <gazebo><plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>2</dimensions><odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/ground_truth</odom_topic><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame>
    </plugin></gazebo>
    <gazebo><plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <ros><remapping>/mecanum_drive_controller/odometry:=/odom</remapping>
        <remapping>/mecanum_drive_controller/tf_odometry:=/tf</remapping></ros>
    </plugin></gazebo>
    <gazebo reference="laser_link"><sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on><update_rate>10</update_rate><topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
        <range><min>0.1</min><max>10</max><resolution>0.01</resolution></range></lidar>
    </sensor></gazebo>
  </xacro:if>
</robot>
