<?xml version="1.0"?>
<sdf version="1.9"><world name="mecanum_acceptance">
<physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><diffuse>1 1 1 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
<model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>12 12 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 12 0.1</size></box></geometry></visual></link></model>
<model name="north"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.1 1</size></box></geometry></visual></link></model>
<model name="south"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>10 0.1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.1 1</size></box></geometry></visual></link></model>
<model name="east"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.1 10 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 10 1</size></box></geometry></visual></link></model>
<model name="west"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.1 10 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 10 1</size></box></geometry></visual></link></model>
</world></sdf>
