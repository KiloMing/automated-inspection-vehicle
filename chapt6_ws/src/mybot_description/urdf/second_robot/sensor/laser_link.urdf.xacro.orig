<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/common_inertia.xacro"/>
    <xacro:macro name="laser_xacro" params="xyz">
        <!-- laser link -->
        <link name="laser_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.04" length="0.03"/>
                </geometry>
                <material name="laser_black">
                    <color rgba = "0.1 0.1 0.1 1"/>
                </material>
            </visual>

                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0"/>
                    <geometry>
                        <cylinder radius="0.04" length="0.03"/>
                    </geometry>
                </collision>
                
                <xacro:cylinder_inertia m="0.3" r="0.04" h="0.03"/>

            
        </link>

        <link name="laser_cylinder_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
                <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
            </collision>

            <xacro:cylinder_inertia m="0.3" r="0.01" h="0.10"/>

        </link>

        <joint name="laser_joint" type="fixed">
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>

        <joint name="laser_cylinder_joint" type="fixed">
            <origin xyz="0.0 0.0 0.065" rpy="0.0 0.0 0.0"/>
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
        </joint>
    
    
    
    
        <gazebo reference="laser_link">
            <sensor name="laser_sensor" type="gpu_lidar">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <topic>/scan</topic>
                <gz_frame_id>laser_link</gz_frame_id>
                <visualize>true</visualize>
                <!-- The housing is centered on laser_link and extends to z=0.015.
                     Put the scan plane above it so the lidar cannot see itself. -->
                <pose>0 0 0.07 0 0 0</pose>

                
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                    </scan>

                    <range>
                        <min>0.10</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>

                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>
</robot>
