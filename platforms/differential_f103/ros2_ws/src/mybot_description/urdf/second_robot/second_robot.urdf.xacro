<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="second_robot">
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/base.urdf.xacro"/>
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/sensor/imu.urdf.xacro"/>
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/sensor/laser_link.urdf.xacro"/>
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/sensor/camera.urdf.xacro"/>
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/sensor/caster.urdf.xacro"/>
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/sensor/wheel.urdf.xacro"/>
    <xacro:include filename="$(find mybot_description)/urdf/second_robot/ros2_control.xacro"/>
    
    <!-- create base -->
    <xacro:base_xacro length="0.12" radius="0.10"/>

    <!-- create IMU -->
    <xacro:imu_xacro xyz="0 0 0.08"/>
    
    <!-- create laser -->
    <xacro:laser_xacro xyz="0 0 0.10"/> 

    <!-- create camera -->
    <xacro:camera_xacro xyz="0.08 0 0.075" rpy="0 0 0"/>

    <!-- create front caster -->
    <xacro:caster_xacro caster_name="front" xyz="0.08 0 -0.076"/>
    <!-- create back caster -->
    <xacro:caster_xacro caster_name="back" xyz="-0.08 0 -0.076"/>

    <!-- create wheels -->
    <xacro:wheel_xacro wheel_name="left" xyz="0 0.11 -0.06"/>
    <xacro:wheel_xacro wheel_name="right" xyz="0 -0.11 -0.06"/>

    <!-- 
    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

            <left_joint>left_joint</left_joint>
            <right_joint>right_joint</right_joint>

            <wheel_separation>0.22</wheel_separation>
            <wheel_radius>0.032</wheel_radius>

            <topic>cmd_vel</topic>

        </plugin>
    </gazebo>
    -->

</robot>
